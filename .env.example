# Токен Telegram-бота от @BotFather (опционально, если запускаете бота)
BOT_TOKEN=

# URL развернутого Telegram Mini App (например, https://my-deal-bot.loca.lt или http://localhost:8000)
WEBAPP_URL=http://localhost:8000

# Ключ SotaVPN (VLESS Reality / Shadowsocks / SOCKS5)
# Трафик через туннель пойдет ИСКЛЮЧИТЕЛЬНО для запросов к Telegram API
# Пример: vless://uuid@server:port?security=reality&pbk=... или ss://...
SOTA_VPN_KEY=

# Или прямой кастомный прокси (если не используется SOTA_VPN_KEY):
# TELEGRAM_PROXY_URL=socks5://127.0.0.1:10808

# Хост и порт сервера
HOST=0.0.0.0
PORT=8000
DEBUG=True

# База данных
DATABASE_URL=sqlite+aiosqlite:///./deals.db
