# Токен Telegram-бота от @BotFather (опционально, если запускаете бота)
BOT_TOKEN=

# URL развернутого Telegram Mini App (например, https://my-deal-bot.loca.lt или http://localhost:8000)
WEBAPP_URL=http://localhost:8000

# Опциональный прокси для обращений к Telegram API (если требуется перенаправить на локальный Sota/VPN-сервис):
# По умолчанию не задан (бот обращается к api.telegram.org напрямую)
# TELEGRAM_PROXY_URL=socks5://127.0.0.1:10808
TELEGRAM_PROXY_URL=

# Хост и порт сервера
HOST=0.0.0.0
PORT=8000
DEBUG=True

# База данных
DATABASE_URL=sqlite+aiosqlite:///./deals.db

# Подписки и доступ
TRIAL_DAYS=3
ADMIN_IDS=
